// Signal logic based on "Momentum Shift [Bigbeluga]" © BigBeluga
// Chart overlay, projected targets and positions by kasutufx, shared under the same license.

//@version=6
// Momentum Shift Positions [kasutufx]
// Price-chart overlay (no oscillator pane), runs on the chart timeframe.
//
// Rules
// 1. Momentum = HMA(close - close[length], smooth), computed in the background (not plotted).
//    Signal when momentum crosses its value 2 bars ago: rising = LONG, falling = SHORT.
//    "Strong only" keeps signals that fire below zero (long) / above zero (short).
// 2. Each signal projects 5 targets from the signal candle: high + n x zone (long) / low - n x zone (short),
//    zone = SMA(high - low, 100) x Shift Zone Size.
// 3. Entry at the close of the signal candle (confirmed bars only, no repaint).
// 4. TP on the chosen projected target (1-5). SL at the signal candle low / high plus an ATR buffer.
// 5. SL moves to break-even at the chosen RR. Optional exit on the opposite signal (counted by result sign).
// 6. One position at a time, optional max trades per day, stats over the lookback window.
// 7. Two smoothed SMA200 lines for context: one on the chart timeframe, one on the 1H timeframe (closed 1H bars).
indicator("Momentum Shift Positions [kasutufx]", shorttitle="MomShift Pos", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, behind_chart=false)

// ===== Inputs =====
length = input.int(50, "Length", group="Momentum", inline="mom")
smooth = input.int(50, "Smooth", group="Momentum", inline="mom")
mult_dist = input.float(1, "Shift Zone Size", step=0.1, group="Momentum", tooltip="Distance between projected targets = SMA(high - low, 100) x this.")
sigMode = input.string("All", "Entry Signals", options=["All", "Strong only"], group="Momentum", tooltip="Strong only = rising below zero / falling above zero.")
col_u = input.color(#3ad79b, "Long", inline="ccc", group="Momentum")
col_d = input.color(#fb6b2e, "Short", inline="ccc", group="Momentum")
showTargets = input.bool(true, "Show Projected Targets", group="Momentum")
active = input.bool(true, "Strategy Active (manual toggle)", group="Positions")
tpZone = input.int(2, "TP Target", minval=1, maxval=5, group="Positions", tooltip="Take profit on this projected target (1-5).")
atrLen = input.int(14, "SL ATR Length", minval=1, group="Positions")
atrMult = input.float(0.5, "SL Buffer (x ATR)", minval=0, step=0.1, group="Positions", tooltip="SL = signal candle low (long) / high (short) plus this many ATRs.")
beRR = input.float(1.0, "Move SL to BE at RR (0 = off)", minval=0, step=0.1, group="Positions")
closeOpp = input.bool(true, "Exit on Opposite Signal", group="Positions", tooltip="Close at the candle close on an opposite signal; a new position in the other direction can open on the same candle.")
lots = input.float(0.10, "Lot Size", minval=0.01, step=0.01, group="Positions")
maxPerDay = input.int(0, "Max Trades Per Day (0 = no limit)", minval=0, group="Positions")
lookbackWeeks = input.int(8, "Lookback (weeks)", minval=1, maxval=52, group="Positions")
showTable = input.bool(true, "Show Info Panel", group="Positions")
maLen = input.int(200, "SMA Length", minval=1, group="Moving Averages")
maSrc = input.source(close, "SMA Source", group="Moving Averages")
smoothType = input.string("SMA", "Smoothing Type", options=["None", "SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Moving Averages", tooltip="Smoothing applied on top of the SMA, as in the built-in Moving Average indicator.")
smoothLen = input.int(14, "Smoothing Length", minval=1, group="Moving Averages")
showMaChart = input.bool(true, "Show SMA (chart TF)", group="Moving Averages")
showMa1H = input.bool(true, "Show SMA (1H TF)", group="Moving Averages")
colMaChart = input.color(color.yellow, "Chart TF Color", group="Moving Averages")
colMa1H = input.color(color.aqua, "1H TF Color", group="Moving Averages")

// ===== Smoothed SMA200: chart TF and 1H TF =====
f_smooth(src, len, t) =>
    switch t
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "SMMA (RMA)" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => src
f_ma() => f_smooth(ta.sma(maSrc, maLen), smoothLen, smoothType)
maChart = f_ma()
// closed 1H bars only (non-repainting)
f_maPrev() =>
    m = f_ma()
    m[1]
ma1H = request.security(syminfo.tickerid, "60", f_maPrev(), lookahead=barmerge.lookahead_on)
plot(showMaChart ? maChart : na, "SMA200 (chart TF)", color=colMaChart, linewidth=2)
plot(showMa1H ? ma1H : na, "SMA200 (1H)", color=colMa1H, linewidth=2)

var label maChartLbl = na
var label ma1HLbl = na
if barstate.islast
    label.delete(maChartLbl)
    label.delete(ma1HLbl)
    smTxt = smoothType == "None" ? "" : " " + smoothType + str.tostring(smoothLen)
    if showMaChart and not na(maChart)
        maChartLbl := label.new(bar_index + 2, maChart, "SMA" + str.tostring(maLen) + smTxt + " (" + timeframe.period + ")  " + str.tostring(maChart, format.mintick), color=color(na), textcolor=colMaChart, style=label.style_label_left, size=size.small)
    if showMa1H and not na(ma1H)
        ma1HLbl := label.new(bar_index + 2, ma1H, "SMA" + str.tostring(maLen) + smTxt + " (1H)  " + str.tostring(ma1H, format.mintick), color=color(na), textcolor=colMa1H, style=label.style_label_left, size=size.small)

// ===== Signals (momentum is not plotted) =====
mom = ta.hma(close - close[length], smooth)
rising = ta.crossover(mom, mom[2])
falling = ta.crossunder(mom, mom[2])
longSig = rising and (sigMode == "All" or mom < 0)
shortSig = falling and (sigMode == "All" or mom > 0)
zone = ta.sma(high - low, 100) * mult_dist
atr = ta.atr(atrLen)

if longSig
    label.new(bar_index, low, mom < 0 ? "△" : "▲", color=color(na), textcolor=col_u, style=label.style_label_up, size=size.small)
if shortSig
    label.new(bar_index, high, mom > 0 ? "▽" : "▼", color=color(na), textcolor=col_d, style=label.style_label_down, size=size.small)

// ===== Projected targets =====
// 5 lines from the signal candle; each stops extending once price reaches it or a new signal fires
var targets = array.new<line>()

f_project(int d) =>
    array.clear(targets)
    col = d == 1 ? col_u : col_d
    base = d == 1 ? high : low
    for i = 1 to 5
        y = base + d * zone * i
        sel = i == tpZone
        ln = line.new(bar_index, y, bar_index + 5, y, color=color.new(col, sel ? 0 : 55), width=sel ? 2 : 1, style=sel ? line.style_solid : line.style_dotted)
        array.push(targets, ln)
        label.new(bar_index, y, "T" + str.tostring(i), color=color(na), textcolor=color.new(col, sel ? 0 : 40), style=label.style_label_right, size=size.tiny)

f_extend(int d) =>
    n = array.size(targets)
    if n > 0
        for i = 0 to n - 1
            ln = array.get(targets, i)
            if not na(ln)
                line.set_x2(ln, bar_index + 5)
                if d == 1 ? high >= line.get_y1(ln) : low <= line.get_y1(ln)
                    line.set_x2(ln, bar_index)
                    array.set(targets, i, line(na))

var int tgtDir = 0
if showTargets and longSig != shortSig and not na(zone)
    tgtDir := longSig ? 1 : -1
    f_project(tgtDir)
else if showTargets and tgtDir != 0
    f_extend(tgtDir)

// ===== Positions =====
var int dir = 0
var int entryBar = na
var float entry = na
var float sl = na
var float tp = na
var float risk = na
var bool be = false
var int wins = 0
var int losses = 0
var int bes = 0
var int day = na
var int dayTrades = 0
var box tpBox = na
var box slBox = na
var line beLn = na

startT = timenow - lookbackWeeks * 7 * 86400000
enabled = active and time_close >= startT and barstate.isconfirmed

dayStart = time("D")
if na(day) or dayStart != day
    day := dayStart
    dayTrades := 0

bool evLong = false
bool evShort = false
bool evExit = false

// Manage the open position (from the candle after entry; SL checked before TP)
if dir != 0 and bar_index > entryBar and barstate.isconfirmed
    float px = na
    string res = ""
    beLevel = entry + dir * risk * beRR
    if dir == 1 ? low <= sl : high >= sl
        px := sl
        res := be ? "BE" : "LOSS"
    else if dir == 1 ? high >= tp : low <= tp
        px := tp
        res := "WIN"
    else if closeOpp and (dir == 1 ? shortSig : longSig)
        px := close
        res := (close - entry) * dir > 0 ? "WIN" : (close - entry) * dir < 0 ? "LOSS" : "BE"
    else if beRR > 0 and not be and (dir == 1 ? high >= beLevel : low <= beLevel)
        be := true
        sl := entry
        beLn := line.new(bar_index, entry, bar_index, entry, color=color.orange, style=line.style_dashed)
    box.set_right(tpBox, bar_index)
    box.set_right(slBox, bar_index)
    if not na(beLn)
        line.set_x2(beLn, bar_index)
    if res != ""
        if res == "WIN"
            wins += 1
        else if res == "LOSS"
            losses += 1
        else
            bes += 1
        col = res == "WIN" ? color.green : res == "LOSS" ? color.red : color.orange
        label.new(bar_index, px, res == "WIN" ? "W" : res == "LOSS" ? "L" : "BE", color=col, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=res + " @ " + str.tostring(px, format.mintick))
        dir := 0
        evExit := true

// Open a new position on a signal
dayFull = maxPerDay > 0 and dayTrades >= maxPerDay
if enabled and dir == 0 and not dayFull and longSig != shortSig and not na(atr) and not na(zone)
    d = longSig ? 1 : -1
    slPx = d == 1 ? low - atr * atrMult : high + atr * atrMult
    tpPx = (d == 1 ? high : low) + d * zone * tpZone
    if d == 1 ? slPx < close and tpPx > close : slPx > close and tpPx < close
        dir := d
        entryBar := bar_index
        entry := close
        sl := slPx
        tp := tpPx
        risk := math.abs(close - slPx)
        be := false
        beLn := na
        dayTrades += 1
        evLong := d == 1
        evShort := d == -1
        // Long / Short Position tool style: green profit zone, red loss zone
        tpBox := box.new(bar_index, math.max(close, tpPx), bar_index + 1, math.min(close, tpPx), border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85))
        slBox := box.new(bar_index, math.max(close, slPx), bar_index + 1, math.min(close, slPx), border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))
        tip = "Signal: momentum " + (d == 1 ? "rising" : "falling") + (mom * d < 0 ? " (strong)" : "") + "\nEntry (" + timeframe.period + " close): " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(slPx, format.mintick) + "\nTP: " + str.tostring(tpPx, format.mintick) + " (T" + str.tostring(tpZone) + ")\nRR: " + str.tostring(math.abs(tpPx - close) / risk, "#.##") + "\nLots: " + str.tostring(lots)
        label.new(bar_index, close, d == 1 ? "L" : "S", color=color.new(color.blue, 20), textcolor=color.white, style=label.style_label_right, size=size.tiny, tooltip=tip)

alertcondition(evLong, "Long Entry", "Momentum Shift: LONG entry")
alertcondition(evShort, "Short Entry", "Momentum Shift: SHORT entry")
alertcondition(evExit, "Trade Exit", "Momentum Shift: trade closed")

// ===== Info panel =====
var table tbl = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
f_row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if showTable and barstate.islast
    statusTxt = not active ? "OFF" : dayFull and dir == 0 ? "DAILY LIMIT REACHED" : dir == 1 ? "IN LONG" : dir == -1 ? "IN SHORT" : "WAITING SIGNAL"
    statusCol = dir != 0 ? color.aqua : color.white
    decided = wins + losses
    winRate = decided > 0 ? wins * 100.0 / decided : 0.0
    wlRatio = losses > 0 ? wins * 1.0 / losses : wins * 1.0
    f_row(0, "Status [" + sigMode + " | TP T" + str.tostring(tpZone) + "]", statusTxt, statusCol)
    f_row(1, "Momentum", mom > 0 ? "Bullish" : "Bearish", mom > 0 ? col_u : col_d)
    f_row(2, "Wins", str.tostring(wins), color.green)
    f_row(3, "Losses", str.tostring(losses), color.red)
    f_row(4, "Break-even", str.tostring(bes), color.orange)
    f_row(5, "Win Rate", str.tostring(winRate, "#.#") + "%", winRate >= 50 ? color.green : color.red)
    f_row(6, "Win/Loss Ratio", str.tostring(wlRatio, "#.##"), wlRatio >= 1 ? color.green : color.red)
    f_row(7, "Trades Today", str.tostring(dayTrades) + (maxPerDay > 0 ? " / " + str.tostring(maxPerDay) : ""), dayFull ? color.orange : color.white)
    f_row(8, "Lookback", str.tostring(lookbackWeeks) + " weeks", color.white)

// Position layer (entries, SL/TP, stats) by kasutufx, shared under the same license.

//@version=6
// Momentum Shift Positions [kasutufx]
// Opens positions on BigBeluga's Momentum Shift signals, locked to the 1H chart.
//
// Rules
// 1. Momentum = HMA(close - close[length], smooth). Signal when momentum crosses its value 2 bars ago:
//    rising = LONG, falling = SHORT. "Strong only" keeps signals that fire below zero (long) / above zero (short).
// 2. Entry at the close of the 1H signal candle (confirmed bars only, no repaint).
// 3. SL at the signal candle low (long) / high (short) plus an ATR buffer.
// 4. TP at the chosen Momentum Shift zone level (zone 0 = signal candle high/low, each zone = SMA(high-low,100) x size).
// 5. SL moves to break-even at the chosen RR. Optional exit on the opposite signal (counted by result sign).
// 6. One position at a time, optional max trades per day, stats over the lookback window.
indicator("Momentum Shift Positions [kasutufx]", shorttitle="MomShift Pos", overlay=false, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ===== Inputs =====
length = input.int(50, "Length", group="Momentum", inline="mom")
smooth = input.int(50, "Smooth", group="Momentum", inline="mom")
mult_dist = input.float(1, "Shift Zone Size", step=0.1, group="Momentum")
col_u = input.color(#3ad79b, "", inline="ccc", group="Momentum")
col_d = input.color(#fb6b2e, "", inline="ccc", group="Momentum")
showZones = input.bool(true, "Show Shift Zones", group="Momentum")
active = input.bool(true, "Strategy Active (manual toggle)", group="Positions")
sigMode = input.string("All", "Entry Signals", options=["All", "Strong only"], group="Positions", tooltip="Strong only = rising below zero / falling above zero (the hollow triangle signals).")
tpZone = input.int(2, "TP Zone", minval=1, maxval=5, group="Positions", tooltip="Take profit at this Momentum Shift zone level (1-5) from the signal candle high (long) / low (short).")
atrLen = input.int(14, "SL ATR Length", minval=1, group="Positions")
atrMult = input.float(0.5, "SL Buffer (x ATR)", minval=0, step=0.1, group="Positions", tooltip="SL = signal candle low (long) / high (short) plus this many ATRs.")
beRR = input.float(1.0, "Move SL to BE at RR (0 = off)", minval=0, step=0.1, group="Positions")
closeOpp = input.bool(true, "Exit on Opposite Signal", group="Positions", tooltip="Close at the candle close on an opposite signal; a new position in the other direction can open on the same candle.")
lots = input.float(0.10, "Lot Size", minval=0.01, step=0.01, group="Positions")
maxPerDay = input.int(0, "Max Trades Per Day (0 = no limit)", minval=0, group="Positions")
lookbackWeeks = input.int(8, "Lookback (weeks)", minval=1, maxval=52, group="Positions")
showTable = input.bool(true, "Show Info Panel", group="Positions")

// ===== Momentum (original Momentum Shift calculation) =====
is1H = timeframe.isintraday and timeframe.in_seconds() == 3600
mom = ta.hma(close - close[length], smooth)
high_ = ta.highest(mom, 150)
low_ = ta.lowest(mom, 150)
color colorM = color.from_gradient(mom, low_, high_, col_d, col_u)
rising = ta.crossover(mom, mom[2])
falling = ta.crossunder(mom, mom[2])
dist = ta.sma(high - low, 100) * mult_dist
atr = ta.atr(atrLen)

// ===== Shift zones (drawn when a signal fires, extended until price reaches them) =====
var lines_up = array.new<line>()
var lines_dn = array.new<line>()
var nums = array.new<label>()

f_delete(array<line> arr) =>
    for ln in arr
        line.delete(ln)
    array.clear(arr)

f_zones(array<line> arr, bool up, color col) =>
    for lb in nums
        label.delete(lb)
    array.clear(nums)
    line prev = na
    for i = 0 to 5
        y = up ? high + dist * i : low - dist * i
        ln = line.new(bar_index + i * 3, y, bar_index + 15 + i * 3, y, force_overlay=true, color=color.new(col, 60 - 10 * i))
        array.push(arr, ln)
        if not na(prev)
            linefill.new(prev, ln, color.new(col, 90 - i * 5))
        prev := ln
        if i > 0
            array.push(nums, label.new(bar_index + i * 3, y, str.tostring(i), color=color(na), style=label.style_label_right, textcolor=color.new(col, 60 - 10 * i), force_overlay=true))

f_extend(array<line> arr, bool up) =>
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            ln = array.get(arr, i)
            if not na(ln)
                line.set_x2(ln, bar_index + 5 + i * 3)
                if up ? high >= line.get_y2(ln) : low <= line.get_y2(ln)
                    line.set_x2(ln, bar_index)
                    array.set(arr, i, line(na))

if showZones and rising
    f_delete(lines_dn)
    array.clear(lines_up)
    f_zones(lines_up, true, col_u)
if showZones and falling
    f_delete(lines_up)
    array.clear(lines_dn)
    f_zones(lines_dn, false, col_d)
if showZones
    f_extend(lines_up, true)
    f_extend(lines_dn, false)

// Signal markers (as in the original)
if rising
    label.new(bar_index, low, "▲", color=color(na), textcolor=color.new(col_u, 50), style=label.style_label_up, force_overlay=true)
    if mom < 0
        label.new(bar_index, mom, "▲", color=color(na), textcolor=col_u, style=label.style_label_up)
        label.new(bar_index, low, "△", color=color(na), textcolor=col_u, style=label.style_label_up, force_overlay=true)
if falling
    label.new(bar_index, high, "▼", color=color(na), textcolor=color.new(col_d, 50), style=label.style_label_down, force_overlay=true)
    if mom > 0
        label.new(bar_index, mom, "▼", color=color(na), textcolor=col_d, style=label.style_label_down)
        label.new(bar_index, high, "▽", color=color(na), textcolor=col_d, style=label.style_label_down, force_overlay=true)

// ===== Positions =====
var int dir = 0
var int entryBar = na
var float entry = na
var float sl = na
var float tp = na
var float risk = na
var bool be = false
var int wins = 0
var int losses = 0
var int bes = 0
var int day = na
var int dayTrades = 0
var box tpBox = na
var box slBox = na
var line beLn = na

startT = timenow - lookbackWeeks * 7 * 86400000
enabled = active and is1H and time_close >= startT and barstate.isconfirmed
longSig = rising and (sigMode == "All" or mom < 0)
shortSig = falling and (sigMode == "All" or mom > 0)

dayStart = time("D")
if na(day) or dayStart != day
    day := dayStart
    dayTrades := 0

f_close(float px, string res) =>
    col = res == "WIN" ? color.green : res == "LOSS" ? color.red : color.orange
    label.new(bar_index, px, res == "WIN" ? "W" : res == "LOSS" ? "L" : "BE", color=col, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=res + " @ " + str.tostring(px, format.mintick), force_overlay=true)

bool evLong = false
bool evShort = false
bool evExit = false

// Manage the open position (from the candle after entry; SL checked before TP)
if dir != 0 and bar_index > entryBar and barstate.isconfirmed
    float px = na
    string res = ""
    beLevel = entry + dir * risk * beRR
    if dir == 1 ? low <= sl : high >= sl
        px := sl
        res := be ? "BE" : "LOSS"
    else if dir == 1 ? high >= tp : low <= tp
        px := tp
        res := "WIN"
    else if closeOpp and (dir == 1 ? falling : rising)
        px := close
        res := (close - entry) * dir > 0 ? "WIN" : (close - entry) * dir < 0 ? "LOSS" : "BE"
    else if beRR > 0 and not be and (dir == 1 ? high >= beLevel : low <= beLevel)
        be := true
        sl := entry
        beLn := line.new(bar_index, entry, bar_index, entry, color=color.orange, style=line.style_dashed, force_overlay=true)
    box.set_right(tpBox, bar_index)
    box.set_right(slBox, bar_index)
    if not na(beLn)
        line.set_x2(beLn, bar_index)
    if res != ""
        if res == "WIN"
            wins += 1
        else if res == "LOSS"
            losses += 1
        else
            bes += 1
        f_close(px, res)
        dir := 0
        evExit := true

// Open a new position on a signal
dayFull = maxPerDay > 0 and dayTrades >= maxPerDay
if enabled and dir == 0 and not dayFull and longSig != shortSig
    d = longSig ? 1 : -1
    slPx = d == 1 ? low - atr * atrMult : high + atr * atrMult
    tpPx = d == 1 ? high + dist * tpZone : low - dist * tpZone
    if (d == 1 ? slPx < close and tpPx > close : slPx > close and tpPx < close) and not na(atr) and not na(dist)
        dir := d
        entryBar := bar_index
        entry := close
        sl := slPx
        tp := tpPx
        risk := math.abs(close - slPx)
        be := false
        beLn := na
        dayTrades += 1
        evLong := d == 1
        evShort := d == -1
        tpBox := box.new(bar_index, math.max(close, tpPx), bar_index + 1, math.min(close, tpPx), border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85), force_overlay=true)
        slBox := box.new(bar_index, math.max(close, slPx), bar_index + 1, math.min(close, slPx), border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85), force_overlay=true)
        tip = "Trigger: momentum " + (d == 1 ? "rising" : "falling") + (mom * d < 0 ? " (strong)" : "") + "\nEntry (1H close): " + str.tostring(close, format.mintick) + "\nSL: " + str.tostring(slPx, format.mintick) + "\nTP: " + str.tostring(tpPx, format.mintick) + " (zone " + str.tostring(tpZone) + ")\nRR: " + str.tostring(math.abs(tpPx - close) / risk, "#.##") + "\nLots: " + str.tostring(lots)
        label.new(bar_index, close, d == 1 ? "L" : "S", color=color.new(color.blue, 20), textcolor=color.white, style=label.style_label_right, size=size.tiny, tooltip=tip, force_overlay=true)

alertcondition(evLong, "Long Entry", "Momentum Shift: LONG entry")
alertcondition(evShort, "Short Entry", "Momentum Shift: SHORT entry")
alertcondition(evExit, "Trade Exit", "Momentum Shift: trade closed")

// ===== Plots (momentum pane, as in the original) =====
hline(0)
pm = plot(mom, color=chart.fg_color)
p0 = plot(0, display=display.none)
fill(pm, p0, high_, low_, mom > 0 ? colorM : na, na)
fill(pm, p0, high_, low_, na, mom < 0 ? colorM : na)

// ===== Info panel =====
var table tbl = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
f_row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if showTable and barstate.islast
    statusTxt = not is1H ? "USE 1H CHART" : not active ? "OFF" : dayFull and dir == 0 ? "DAILY LIMIT REACHED" : dir == 1 ? "IN LONG" : dir == -1 ? "IN SHORT" : "WAITING SIGNAL"
    statusCol = not is1H ? color.red : dir != 0 ? color.aqua : color.white
    decided = wins + losses
    winRate = decided > 0 ? wins * 100.0 / decided : 0.0
    wlRatio = losses > 0 ? wins * 1.0 / losses : wins * 1.0
    f_row(0, "Status [" + sigMode + " | TP zone " + str.tostring(tpZone) + "]", statusTxt, statusCol)
    f_row(1, "Momentum", str.tostring(mom, "#.##"), mom > 0 ? col_u : col_d)
    f_row(2, "Wins", str.tostring(wins), color.green)
    f_row(3, "Losses", str.tostring(losses), color.red)
    f_row(4, "Break-even", str.tostring(bes), color.orange)
    f_row(5, "Win Rate", str.tostring(winRate, "#.#") + "%", winRate >= 50 ? color.green : color.red)
    f_row(6, "Win/Loss Ratio", str.tostring(wlRatio, "#.##"), wlRatio >= 1 ? color.green : color.red)
    f_row(7, "Trades Today", str.tostring(dayTrades) + (maxPerDay > 0 ? " / " + str.tostring(maxPerDay) : ""), dayFull ? color.orange : color.white)
    f_row(8, "Lookback", str.tostring(lookbackWeeks) + " weeks", color.white)

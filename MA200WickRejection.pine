//@version=6
// MA200 Wick Rejection [kasutufx]
// Bot-assisted strategy visualizer (indicator only, no orders).
//
// Rules
// 1. 1H SMA(200) computed on LOW prices.
// 2. Manual toggle "Strategy Active" (or Auto mode). When ON, waits for price to touch / pass the 1H MA (ARMED).
//    One trade per touch: after a trade closes, price must leave the MA and touch it again.
// 3. Entry when ARMED on either trigger (OR):
//    a) Wick rejection on 5m and/or 15m, entered at the close of the next 3m candle:
//       LONG  = prev close above MA, wick trades at/below MA, candle closes back above MA.
//       SHORT = prev close below MA, wick trades at/above MA, candle closes back below MA.
//       SL at the high/low of the wick candle.
//    b) Triple close reversal: the last 3+ closed 3m AND 5m candles all closed bullish (long) / bearish (short),
//       the run starts at the MA (its first candle or the one before touched it) and every close is on the
//       trade side of the MA. Entered at that 3m close. SL at the run's extreme low (long) / high (short).
// 4. User lot size. SL as set by the entry trigger (+ optional buffer), no risk cap.
// 5. 100% TP at the rolling 24h high (long) / low (short), rounded to a whole number toward entry.
//    If entry is at the 24h extreme (no room), the previous day high/low is used instead.
// 6. SL moves to break-even once 1R is reached.
// 7. Optional max trades per day (trading day = the symbol's daily session).
// Same 3m candle SL+TP touch is counted as SL (conservative).
//
// Engine: runs on the 3m / 5m / 15m candles inside each chart bar, so every chart timeframe
// from 3m to 1H gives the same trades. Use the 1H chart for the longest history.
//
// MT5 port notes (for the EA version later)
// MA       : iMA(_Symbol, PERIOD_H1, 200, 0, MODE_SMA, PRICE_LOW), read closed bar (shift 1) via CopyBuffer
// Wicks    : CopyRates(_Symbol, PERIOD_M5 / PERIOD_M15, 1, 2, rates) on new bar, entry on PERIOD_M3 close
// PDH/PDL  : iHigh/iLow(_Symbol, PERIOD_D1, 1) (fallback target)
// 24h H/L  : iHighest/iLowest(_Symbol, PERIOD_M15, MODE_HIGH/MODE_LOW, 96, 1) -> iHigh/iLow at that shift
// MA notes : create the iMA handle once in OnInit, check BarsCalculated before CopyBuffer, IndicatorRelease in OnDeinit
// Risk     : lossPerLot = (slDist / SYMBOL_TRADE_TICK_SIZE) * SYMBOL_TRADE_TICK_VALUE_LOSS
//            or OrderCalcProfit(type, _Symbol, lots, entry, sl, loss) (EA/script only, already in deposit currency)
// Lots     : normalize with SYMBOL_VOLUME_MIN / SYMBOL_VOLUME_STEP / SYMBOL_VOLUME_MAX, OrderCheck before OrderSend
// BE       : CTrade.PositionModify(ticket, entryPrice, tp), only if price is beyond SYMBOL_TRADE_STOPS_LEVEL
//            and SYMBOL_TRADE_FREEZE_LEVEL (points) from the current price
indicator("MA200 Wick Rejection [kasutufx]", shorttitle="MA200 Wick", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, behind_chart=false)

// ===== Inputs =====
mode = input.string("Manual", "Mode", options=["Manual", "Auto"], group="Control", display=display.none, tooltip="Manual = uses the toggle. Auto = always on, re-arms after every trade.")
active = input.bool(true, "Strategy Active (manual toggle)", group="Control", display=display.none)
maxPerDay = input.int(0, "Max Trades Per Day (0 = no limit)", minval=0, group="Control", display=display.none, tooltip="Counts entries per trading day (the symbol's daily session). Once reached, new setups are ignored until the next day.")
lookbackWeeks = input.int(8, "Lookback (weeks)", minval=1, maxval=52, group="Control", display=display.none, tooltip="Signals and stats cover this many weeks back from now. Needs enough chart history: the 1H chart covers 8 weeks on every plan.")
maLen = input.int(200, "MA Length", minval=1, group="Moving Average", display=display.none)
maTF = input.timeframe("60", "MA Timeframe", group="Moving Average", display=display.none)
smoothType = input.string("None", "Smoothing Type", options=["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Smoothing", display=display.none, tooltip="Same smoothing options as the built-in TradingView Moving Average indicator, applied to the 1H MA.")
smoothLen = input.int(14, "Smoothing Length", minval=1, group="Smoothing", display=display.none)
bbMult = input.float(2.0, "BB StdDev", minval=0.001, maxval=50, step=0.5, group="Smoothing", display=display.none, tooltip="Only used with SMA + Bollinger Bands.")
signalLine = input.string("Smoothed MA", "Strategy Uses", options=["Smoothed MA", "Raw MA"], group="Smoothing", display=display.none, tooltip="Which line the touch and wick rules use. Falls back to the raw MA when Smoothing Type is None.")
useWick = input.bool(true, "Entry: Wick Rejection (5m / 15m)", group="Entry", display=display.none, tooltip="Wick rejection of the MA on 5m and/or 15m, entered at the close of the next 3m candle. SL at the wick candle high/low.")
useTriple = input.bool(true, "Entry: Triple Close Reversal (3m + 5m)", group="Entry", display=display.none, tooltip="The last 3 closed 3m and 5m candles are all bullish (long) or all bearish (short) and reversed off the MA: the run starts at the MA (its first candle or the one before touched it) and every close is above (long) / below (short) the MA. Entered at that 3m close. SL at the run's extreme.")
wickMode = input.string("5m or 15m", "Wick Timeframe", options=["5m", "15m", "5m or 15m", "5m and 15m"], group="Entry", display=display.none, tooltip="Which wick candles count for the wick rejection entry.")
lots = input.float(0.10, "Lot Size", minval=0.01, step=0.01, group="Risk", display=display.none)
slBuffer = input.float(0, "SL Buffer (price) beyond wick", minval=0, group="Risk", display=display.none, tooltip="Extra distance added beyond the wick candle high/low. Eg. 0.5 = 50 cents on gold.")
wholeStep = input.float(1.0, "Whole Number Step", minval=0, group="Targets", display=display.none, tooltip="TP = rolling 24h high/low rounded to this step toward entry. 1.0 for gold, 0.01 for EURUSD. 0 = no rounding.")
beRR = input.float(1.0, "Move SL to BE at RR", minval=0.1, step=0.1, group="Targets", display=display.none)
showPD = input.bool(false, "Show 24h High/Low", group="Display", display=display.none)
showTable = input.bool(true, "Show Info Panel", group="Display", display=display.none)
showSkips = input.bool(false, "Show Skipped Signals", group="Display", display=display.none, tooltip="Marks every wick rejection that did not become a trade with a small grey x. Hover it to see why.")

// ===== Constants =====
MS3 = 180000
MS5 = 300000
MS15 = 900000
use5 = wickMode == "5m" or wickMode == "5m or 15m"
use15 = wickMode == "15m" or wickMode == "5m or 15m"
both = wickMode == "5m and 15m"
chartSec = timeframe.in_seconds()
tfOk = timeframe.isintraday and chartSec >= 180 and chartSec <= 3600

// ===== MA (closed 1H bars only, non-repainting) =====
// Smoothing, as in the built-in Moving Average indicator
f_smooth(src, len, t) =>
    switch t
        "SMA" => ta.sma(src, len)
        "SMA + Bollinger Bands" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "SMMA (RMA)" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => na
f_maSet() =>
    base = ta.sma(low, maLen)
    sm = f_smooth(base, smoothLen, smoothType)
    dev = smoothType == "SMA + Bollinger Bands" ? ta.stdev(base, smoothLen) * bbMult : na
    [base[1], sm[1], dev[1]]
[maRaw, maSmooth, maDev] = request.security(syminfo.tickerid, maTF, f_maSet(), lookahead=barmerge.lookahead_on)
smoothOn = smoothType != "None"
useSmooth = smoothOn and signalLine == "Smoothed MA"
ma = useSmooth ? maSmooth : maRaw
// Rolling 24h high/low for display (closed 15m candles)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[hi24, lo24] = request.security(syminfo.tickerid, "15", [ta.highest(high, 96)[1], ta.lowest(low, 96)[1]], lookahead=barmerge.lookahead_on)

// ===== 3m / 5m / 15m candles of the current chart bar =====
// Lower than or equal to chart TF: all candles inside the bar. Higher: the candle that just closed.
f_candles(simple string tf) =>
    isLower = timeframe.in_seconds(tf) <= chartSec
    [tL, oL, hL, lL, cL] = request.security_lower_tf(syminfo.tickerid, isLower ? tf : timeframe.period, [time, open, high, low, close])
    [tH, oH, hH, lH, cH] = request.security(syminfo.tickerid, isLower ? timeframe.period : tf, [time[1], open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
    take = not isLower and timeframe.change(tf) and not na(tH)
    tA = isLower ? tL : take ? array.from(tH) : array.new<int>()
    oA = isLower ? oL : take ? array.from(oH) : array.new<float>()
    hA = isLower ? hL : take ? array.from(hH) : array.new<float>()
    lA = isLower ? lL : take ? array.from(lH) : array.new<float>()
    cA = isLower ? cL : take ? array.from(cH) : array.new<float>()
    [tA, oA, hA, lA, cA]
[t3, o3, h3, l3, c3] = f_candles("3")
[t5, o5, h5, l5, c5] = f_candles("5")
[t15, o15, h15, l15, c15] = f_candles("15")

// Rolling 24h (96 x 15m) high/low as of each 15m candle close, aligned with the 15m candles above
f_range24() =>
    isLower = 900 <= chartSec
    [hiL, loL] = request.security_lower_tf(syminfo.tickerid, isLower ? "15" : timeframe.period, [ta.highest(high, 96), ta.lowest(low, 96)])
    [hiH, loH] = request.security(syminfo.tickerid, isLower ? timeframe.period : "15", [ta.highest(high, 96)[1], ta.lowest(low, 96)[1]], lookahead=barmerge.lookahead_on)
    take = not isLower and timeframe.change("15") and not na(hiH)
    hA = isLower ? hiL : take ? array.from(hiH) : array.new<float>()
    lA = isLower ? loL : take ? array.from(loH) : array.new<float>()
    [hA, lA]
[r24h, r24l] = f_range24()

// ===== Engine =====
// Consecutive bullish / bearish closes on one timeframe, and whether the streak is a reversal off the MA
type Streak
    int up = 0
    int dn = 0
    bool upTouch = false
    bool dnTouch = false
    bool upSide = false
    bool dnSide = false
    float upLow = na
    float dnHigh = na
    float pl = na
    float ph = na

f_streak(Streak s, float o, float h, float l, float c, float m) =>
    if c > o
        if s.up == 0
            s.upTouch := l <= m or (not na(s.pl) and s.pl <= m)
            s.upSide := c > m
            s.upLow := na(s.pl) ? l : math.min(l, s.pl)
        else
            s.upSide := s.upSide and c > m
            s.upLow := math.min(s.upLow, l)
        s.up := s.up + 1
    else
        s.up := 0
    if c < o
        if s.dn == 0
            s.dnTouch := h >= m or (not na(s.ph) and s.ph >= m)
            s.dnSide := c < m
            s.dnHigh := na(s.ph) ? h : math.max(h, s.ph)
        else
            s.dnSide := s.dnSide and c < m
            s.dnHigh := math.max(s.dnHigh, h)
        s.dn := s.dn + 1
    else
        s.dn := 0
    s.pl := l
    s.ph := h

// 3+ closes in direction d that reversed off the MA
f_reversed(Streak s, int d) => d == 1 ? s.up >= 3 and s.upTouch and s.upSide : s.dn >= 3 and s.dnTouch and s.dnSide

// state: 0 = OFF, 1 = WAIT MA TOUCH, 2 = ARMED, 4 = WICK FOUND, WAIT 3M CLOSE, 3 = IN TRADE
type Engine
    int state = 0
    bool fresh = true
    int dir = 0
    int pDir = 0
    float pSl = na
    int pT = na
    float entry = na
    float sl = na
    float tp = na
    float risk = na
    bool be = false
    float prev3 = na
    float prev5 = na
    float prev15 = na
    float hi24 = na
    float lo24 = na
    int bull5T = na
    int bear5T = na
    Streak s3
    Streak s5
    bool tripL = false
    bool tripS = false
    int wins = 0
    int losses = 0
    int bes = 0
    int day = na
    int dayTrades = 0
    box tpBox = na
    box slBox = na
    line beLn = na
    bool evLong = false
    bool evShort = false
    bool evExit = false

// Grey x on a setup that did not become a trade, reason in the tooltip
f_skip(int T, float y, int d, string why) =>
    if showSkips
        label.new(T, y, "x", xloc=xloc.bar_time, color=color.new(color.gray, 100), textcolor=color.gray, style=d == 1 ? label.style_label_up : label.style_label_down, size=size.tiny, tooltip=(d == 1 ? "Long" : "Short") + " setup skipped - " + why)

f_whole(p, step, down) => step > 0 ? (down ? math.floor(p / step) * step : math.ceil(p / step) * step) : p

f_why(Engine e) => e.state == 3 ? "a trade is still open" : e.state == 4 ? "already waiting for a 3m entry" : e.state == 0 ? "strategy off / outside lookback" : e.state == 1 ? (e.fresh ? "not armed yet (no MA touch since activation)" : "not armed (needs a fresh MA touch after the last trade)") : "daily trade limit reached"

// Open a position at close c with stop slRaw; returns true when opened
f_open(Engine e, int d, int T, float c, float slRaw, float pdhV, float pdlV, string trig) =>
    tp24 = d == 1 ? f_whole(e.hi24, wholeStep, true) : f_whole(e.lo24, wholeStep, false)
    tpPd = d == 1 ? f_whole(pdhV, wholeStep, true) : f_whole(pdlV, wholeStep, false)
    ok24 = not na(tp24) and (d == 1 ? tp24 > c : tp24 < c)
    // entry at the 24h extreme -> fall back to the previous day high/low
    tp0 = ok24 ? tp24 : tpPd
    rawDist = d == 1 ? c - slRaw : slRaw - c
    validTp = not na(tp0) and (d == 1 ? tp0 > c : tp0 < c)
    bool opened = false
    if rawDist <= 0 or not validTp
        f_skip(T, c, d, trig + ": " + (rawDist <= 0 ? "entry closed beyond the stop (no room for SL)" : "no room to the 24h / prev day target"))
    else
        dist = rawDist
        e.state := 3
        e.dir := d
        e.entry := c
        e.sl := c - d * dist
        e.tp := tp0
        e.risk := dist
        e.be := false
        e.beLn := na
        e.evLong := d == 1
        e.evShort := d == -1
        e.dayTrades := e.dayTrades + 1
        opened := true
        // Long / Short Position tool style: green profit zone, red loss zone
        e.tpBox := box.new(T, math.max(c, tp0), T, math.min(c, tp0), xloc=xloc.bar_time, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85))
        e.slBox := box.new(T, math.max(c, e.sl), T, math.min(c, e.sl), xloc=xloc.bar_time, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))
        tip = "Trigger: " + trig + "\nEntry (3m close): " + str.tostring(c, format.mintick) + "\nSL: " + str.tostring(e.sl, format.mintick) + "\nTP: " + str.tostring(tp0, format.mintick) + (ok24 ? " (24h)" : " (prev day)") + "\nRR: " + str.tostring(math.abs(tp0 - c) / dist, "#.##") + "\nLots: " + str.tostring(lots)
        label.new(T, c, d == 1 ? "L" : "S", xloc=xloc.bar_time, color=color.new(color.blue, 20), textcolor=color.white, style=label.style_label_right, size=size.tiny, tooltip=tip)
    opened

// A closed 5m / 15m candle: wick rejection check
f_wick(Engine e, bool is5, int t, float o, float h, float l, float c, float m, float rh, float rl) =>
    T = t + (is5 ? MS5 : MS15)
    pc = is5 ? e.prev5 : e.prev15
    bull = not na(pc) and pc > m and l <= m and c > m
    bear = not na(pc) and pc < m and h >= m and c < m
    bool sigL = false
    bool sigS = false
    if is5
        e.prev5 := c
        f_streak(e.s5, o, h, l, c, m)
        if bull
            e.bull5T := T
        if bear
            e.bear5T := T
        sigL := useWick and use5 and bull
        sigS := useWick and use5 and bear
    else
        e.prev15 := c
        e.hi24 := rh
        e.lo24 := rl
        sigL := useWick and ((use15 and bull) or (both and bull and e.bull5T == T))
        sigS := useWick and ((use15 and bear) or (both and bear and e.bear5T == T))
    dayFull = maxPerDay > 0 and e.dayTrades >= maxPerDay
    if sigL != sigS and (e.state != 2 or dayFull)
        d = sigL ? 1 : -1
        f_skip(T, d == 1 ? l : h, d, "wick: " + f_why(e))
    if e.state == 2 and sigL != sigS and not dayFull
        d = sigL ? 1 : -1
        e.pSl := (d == 1 ? l : h) - d * slBuffer
        e.pDir := d
        e.pT := T
        e.state := 4

// A closed 3m candle: manage trade, fill pending entry, detect MA touch
f_bar3(Engine e, int t, float o, float h, float l, float c, float m, float pdhV, float pdlV) =>
    T = t + MS3
    f_streak(e.s3, o, h, l, c, m)
    // keep the 24h range current between 15m closes
    e.hi24 := na(e.hi24) ? na : math.max(e.hi24, h)
    e.lo24 := na(e.lo24) ? na : math.min(e.lo24, l)
    if e.state == 3
        float px = na
        string res = ""
        beLevel = e.entry + e.dir * e.risk * beRR
        if e.dir == 1 ? l <= e.sl : h >= e.sl
            px := e.sl
            res := e.be ? "BE" : "LOSS"
        else if e.dir == 1 ? h >= e.tp : l <= e.tp
            px := e.tp
            res := "WIN"
        else if not e.be and (e.dir == 1 ? h >= beLevel : l <= beLevel)
            e.be := true
            e.sl := e.entry
            e.beLn := line.new(T, e.entry, T, e.entry, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed)
        box.set_right(e.tpBox, T)
        box.set_right(e.slBox, T)
        if not na(e.beLn)
            line.set_x2(e.beLn, T)
        if res != ""
            if res == "WIN"
                e.wins := e.wins + 1
            else if res == "LOSS"
                e.losses := e.losses + 1
            else
                e.bes := e.bes + 1
            col = res == "WIN" ? color.green : res == "LOSS" ? color.red : color.orange
            label.new(T, px, res == "WIN" ? "W" : res == "LOSS" ? "L" : "BE", xloc=xloc.bar_time, color=col, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=res + " @ " + str.tostring(px, format.mintick))
            e.state := 1
            e.dir := 0
            e.fresh := false
            e.evExit := true
    else if e.state == 4 and T > e.pT
        // wick entry: next 3m close after the wick candle
        if not f_open(e, e.pDir, T, c, e.pSl, pdhV, pdlV, "wick")
            e.state := 2
    // triple close reversal entry: fires once when the 3m + 5m run first qualifies
    tripL = useTriple and f_reversed(e.s3, 1) and f_reversed(e.s5, 1)
    tripS = useTriple and f_reversed(e.s3, -1) and f_reversed(e.s5, -1)
    newL = tripL and not e.tripL
    newS = tripS and not e.tripS
    e.tripL := tripL
    e.tripS := tripS
    if newL != newS
        d = newL ? 1 : -1
        dayFull = maxPerDay > 0 and e.dayTrades >= maxPerDay
        if e.state == 2 and not dayFull
            slRaw = (d == 1 ? math.min(e.s3.upLow, e.s5.upLow) : math.max(e.s3.dnHigh, e.s5.dnHigh)) - d * slBuffer
            f_open(e, d, T, c, slRaw, pdhV, pdlV, "triple close")
        else if e.state != 3 or e.dir != d
            f_skip(T, c, d, "triple close: " + f_why(e))
    // Touch / pass of the MA; a fresh touch is needed after each trade
    touch = (l <= m and h >= m) or (not na(e.prev3) and ((l > m and e.prev3 < m) or (h < m and e.prev3 > m)))
    if not touch
        e.fresh := true
    if e.state == 1 and touch and e.fresh
        e.state := 2
    e.prev3 := c

var Engine eng = Engine.new(s3=Streak.new(), s5=Streak.new())
eng.evLong := false
eng.evShort := false
eng.evExit := false

startT = timenow - lookbackWeeks * 7 * 86400000
inLookback = time_close >= startT
enabled = (mode == "Auto" or active) and tfOk and inLookback and not na(ma)

// New trading day -> reset the daily trade count
dayStart = time("D")
if na(eng.day) or dayStart != eng.day
    eng.day := dayStart
    eng.dayTrades := 0

if not enabled and eng.state != 3
    eng.state := 0
else if enabled and eng.state == 0
    eng.state := 1

// Walk the closed candles of this bar in time order (only inside the lookback window)
// Confirmed bars: every candle is closed. Live bar: skip the candle still forming.
nowT = barstate.isconfirmed ? time_close : timenow
if tfOk and inLookback and not na(ma)
    n3 = array.size(t3)
    n5 = array.size(t5)
    n15 = array.size(t15)
    i5 = 0
    i15 = 0
    if n3 > 0
        for i = 0 to n3 - 1
            T3 = array.get(t3, i) + MS3
            if T3 > nowT
                break
            // 5m / 15m candles that closed by the time this 3m candle closed
            // (a wick at the same time still fills on the next 3m close: see T > e.pT)
            while i5 < n5 and array.get(t5, i5) + MS5 <= T3
                f_wick(eng, true, array.get(t5, i5), array.get(o5, i5), array.get(h5, i5), array.get(l5, i5), array.get(c5, i5), ma, na, na)
                i5 += 1
            while i15 < n15 and array.get(t15, i15) + MS15 <= T3
                f_wick(eng, false, array.get(t15, i15), array.get(o15, i15), array.get(h15, i15), array.get(l15, i15), array.get(c15, i15), ma, i15 < array.size(r24h) ? array.get(r24h, i15) : na, i15 < array.size(r24l) ? array.get(r24l, i15) : na)
                i15 += 1
            f_bar3(eng, array.get(t3, i), array.get(o3, i), array.get(h3, i), array.get(l3, i), array.get(c3, i), ma, pdh, pdl)
    // wick candles closing at the end of this bar
    while i5 < n5 and array.get(t5, i5) + MS5 <= nowT
        f_wick(eng, true, array.get(t5, i5), array.get(o5, i5), array.get(h5, i5), array.get(l5, i5), array.get(c5, i5), ma, na, na)
        i5 += 1
    while i15 < n15 and array.get(t15, i15) + MS15 <= nowT
        f_wick(eng, false, array.get(t15, i15), array.get(o15, i15), array.get(h15, i15), array.get(l15, i15), array.get(c15, i15), ma, i15 < array.size(r24h) ? array.get(r24h, i15) : na, i15 < array.size(r24l) ? array.get(r24l, i15) : na)
        i15 += 1

// ===== Plots =====
plot(maRaw, "1H SMA200 (Low)", color=color.yellow, linewidth=2)
plot(smoothOn ? maSmooth : na, "Smoothed MA", color=color.aqua, linewidth=2)
bbUp = plot(smoothOn ? maSmooth + maDev : na, "BB Upper", color=color.new(color.green, 50))
bbLo = plot(smoothOn ? maSmooth - maDev : na, "BB Lower", color=color.new(color.green, 50))
fill(bbUp, bbLo, color=color.new(color.green, 92), title="BB Fill")
plot(showPD ? hi24 : na, "24h High", color=color.new(color.green, 60), style=plot.style_stepline)
plot(showPD ? lo24 : na, "24h Low", color=color.new(color.red, 60), style=plot.style_stepline)

alertcondition(eng.evLong, "Long Entry", "MA200 Wick: LONG entry")
alertcondition(eng.evShort, "Short Entry", "MA200 Wick: SHORT entry")
alertcondition(eng.evExit, "Trade Exit", "MA200 Wick: trade closed")

// ===== Info panel =====
var table tbl = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
f_row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if showTable and barstate.islast
    st = eng.state
    dayFull = maxPerDay > 0 and eng.dayTrades >= maxPerDay
    statusTxt = not tfOk ? "USE 3m - 1H CHART" : st == 0 ? "OFF" : (st == 1 or st == 2) and dayFull ? "DAILY LIMIT REACHED" : st == 1 ? "WAITING 1H MA TOUCH" : st == 2 ? "ARMED - WAIT ENTRY" : st == 4 ? "WICK - WAIT 3M CLOSE" : eng.dir == 1 ? "IN LONG" : "IN SHORT"
    statusCol = st == 3 ? color.aqua : st == 2 or st == 4 ? color.yellow : st == 1 ? color.white : color.gray
    decided = eng.wins + eng.losses
    winRate = decided > 0 ? eng.wins * 100.0 / decided : 0.0
    wlRatio = eng.losses > 0 ? eng.wins * 1.0 / eng.losses : eng.wins * 1.0
    f_row(0, "Status [" + mode + " | " + wickMode + "]", statusTxt, statusCol)
    f_row(1, (useSmooth ? "1H Smoothed MA" : "1H MA") + str.tostring(maLen), str.tostring(ma, format.mintick), useSmooth ? color.aqua : color.yellow)
    f_row(2, "24h High / Low", str.tostring(eng.hi24, format.mintick) + " / " + str.tostring(eng.lo24, format.mintick), color.white)
    f_row(3, "Wins", str.tostring(eng.wins), color.green)
    f_row(4, "Losses", str.tostring(eng.losses), color.red)
    f_row(5, "Break-even", str.tostring(eng.bes), color.orange)
    f_row(6, "Win Rate", str.tostring(winRate, "#.#") + "%", winRate >= 50 ? color.green : color.red)
    f_row(7, "Win/Loss Ratio", str.tostring(wlRatio, "#.##"), wlRatio >= 1 ? color.green : color.red)
    f_row(8, "Trades Today", str.tostring(eng.dayTrades) + (maxPerDay > 0 ? " / " + str.tostring(maxPerDay) : ""), dayFull ? color.orange : color.white)
    f_row(9, "Lookback", str.tostring(lookbackWeeks) + " weeks", color.white)

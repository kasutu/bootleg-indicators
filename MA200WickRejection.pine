//@version=6
// MA200 Wick Rejection [kasutufx]
// Bot-assisted strategy visualizer (indicator only, no orders).
//
// Rules
// 1. 1H SMA(200) computed on LOW prices.
// 2. Manual toggle "Strategy Active" (or Auto mode). When ON, waits for price to touch / pass the 1H MA (ARMED).
// 3. Entry on a 5m and/or 15m wick rejection of the MA:
//    LONG  = prev close above MA, wick trades at/below MA, candle closes back above MA.
//    SHORT = prev close below MA, wick trades at/above MA, candle closes back below MA.
//    The position is placed at the close of the next 3m candle after the wick candle closes.
// 4. User lot size. SL at the wick of the 3m entry candle (+ optional buffer), capped so risk <= Max SL Risk % of balance.
// 5. 100% TP at previous day high (long) / low (short), rounded to a whole number toward entry.
// 6. SL moves to break-even once 1R is reached.
// Same bar SL+TP touch is counted as SL (conservative).
//
// MT5 port notes (for the EA version later)
// MA       : iMA(_Symbol, PERIOD_H1, 200, 0, MODE_SMA, PRICE_LOW), read closed bar (shift 1) via CopyBuffer
// Wicks    : CopyRates(_Symbol, PERIOD_M5 / PERIOD_M15, 1, 2, rates) on new bar
// PDH/PDL  : iHigh/iLow(_Symbol, PERIOD_D1, 1)
// MA notes : create the iMA handle once in OnInit, check BarsCalculated before CopyBuffer, IndicatorRelease in OnDeinit
// Risk     : lossPerLot = (slDist / SYMBOL_TRADE_TICK_SIZE) * SYMBOL_TRADE_TICK_VALUE_LOSS
//            or OrderCalcProfit(type, _Symbol, lots, entry, sl, loss) (EA/script only, already in deposit currency)
//            Contract Size input below = SYMBOL_TRADE_CONTRACT_SIZE
// Lots     : normalize with SYMBOL_VOLUME_MIN / SYMBOL_VOLUME_STEP / SYMBOL_VOLUME_MAX, OrderCheck before OrderSend
// BE       : CTrade.PositionModify(ticket, entryPrice, tp), only if price is beyond SYMBOL_TRADE_STOPS_LEVEL
//            and SYMBOL_TRADE_FREEZE_LEVEL (points) from the current price
indicator("MA200 Wick Rejection [kasutufx]", shorttitle="MA200 Wick", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ===== Inputs =====
mode = input.string("Manual", "Mode", options=["Manual", "Auto"], group="Control", display=display.none, tooltip="Manual = uses the toggle and Active From date. Auto = always on across all chart history, re-arms after every trade.")
active = input.bool(true, "Strategy Active (manual toggle)", group="Control", display=display.none)
startTime = input.time(timestamp("2025-01-01T00:00:00"), "Active From", group="Control", display=display.none, tooltip="Manual mode only. Signals and stats are only counted from this date.")
maLen = input.int(200, "MA Length", minval=1, group="Moving Average", display=display.none)
maTF = input.timeframe("60", "MA Timeframe", group="Moving Average", display=display.none)
smoothType = input.string("None", "Smoothing Type", options=["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group="Smoothing", display=display.none, tooltip="Same smoothing options as the built-in TradingView Moving Average indicator, applied to the 1H MA.")
smoothLen = input.int(14, "Smoothing Length", minval=1, group="Smoothing", display=display.none)
bbMult = input.float(2.0, "BB StdDev", minval=0.001, maxval=50, step=0.5, group="Smoothing", display=display.none, tooltip="Only used with SMA + Bollinger Bands.")
signalLine = input.string("Smoothed MA", "Strategy Uses", options=["Smoothed MA", "Raw MA"], group="Smoothing", display=display.none, tooltip="Which line the touch and wick rules use. Falls back to the raw MA when Smoothing Type is None.")
wickMode = input.string("5m or 15m", "Wick Confirmation", options=["5m", "15m", "5m or 15m", "5m and 15m"], group="Entry", display=display.none, tooltip="Entry is placed at the close of the next 3m candle after the wick candle.")
balanceIn = input.float(10000, "Account Balance", minval=1, group="Risk", display=display.none, tooltip="Only used for the max SL risk cap.")
lots = input.float(0.10, "Lot Size", minval=0.01, step=0.01, group="Risk", display=display.none)
contractIn = input.float(0, "Contract Size (0 = auto)", minval=0, group="Risk", display=display.none, tooltip="MT5 SYMBOL_TRADE_CONTRACT_SIZE. 0 = auto: XAU 100, XAG 5000, forex 100000, others 1. Only used for the max SL risk cap.")
slBuffer = input.float(0, "SL Buffer (price) beyond wick", minval=0, group="Risk", display=display.none, tooltip="Extra distance added beyond the 3m candle wick. Eg. 0.5 = 50 cents on gold.")
maxRiskPct = input.float(30, "Max SL Risk % of Balance", minval=0.1, maxval=100, group="Risk", display=display.none)
wholeStep = input.float(1.0, "Whole Number Step", minval=0, group="Targets", display=display.none, tooltip="TP = prev day high/low rounded to this step toward entry. 1.0 for gold, 0.01 for EURUSD. 0 = no rounding.")
beRR = input.float(1.0, "Move SL to BE at RR", minval=0.1, step=0.1, group="Targets", display=display.none)
showPD = input.bool(false, "Show Prev Day High/Low", group="Display", display=display.none)
showTable = input.bool(true, "Show Stats Table", group="Display", display=display.none)

// ===== Data =====
// Smoothing, as in the built-in Moving Average indicator
f_smooth(src, len, t) =>
    switch t
        "SMA" => ta.sma(src, len)
        "SMA + Bollinger Bands" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "SMMA (RMA)" => ta.rma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        => na
// Closed 1H bar values only (non-repainting)
f_maSet() =>
    base = ta.sma(low, maLen)
    sm = f_smooth(base, smoothLen, smoothType)
    dev = smoothType == "SMA + Bollinger Bands" ? ta.stdev(base, smoothLen) * bbMult : na
    [base[1], sm[1], dev[1]]
[maRaw, maSmooth, maDev] = request.security(syminfo.tickerid, maTF, f_maSet(), lookahead=barmerge.lookahead_on)
smoothOn = smoothType != "None"
useSmooth = smoothOn and signalLine == "Smoothed MA"
ma = useSmooth ? maSmooth : maRaw
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Last closed 5m / 15m candle: [high, low, close, previous close]
f_bar() => [high[1], low[1], close[1], close[2]]
[h5, l5, c5, pc5] = request.security(syminfo.tickerid, "5", f_bar(), lookahead=barmerge.lookahead_on)
[h15, l15, c15, pc15] = request.security(syminfo.tickerid, "15", f_bar(), lookahead=barmerge.lookahead_on)
new5 = timeframe.change("5")
new15 = timeframe.change("15")

// 3m entry candle
// chart <= 3m : wait for the next 3m candle to close and use its close
// chart > 3m  : read the 3m candles inside the chart bar and use the first one's close
chartSec = timeframe.in_seconds()
lowTf = chartSec <= 180
[h3, l3, c3] = request.security(syminfo.tickerid, lowTf ? "3" : timeframe.period, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
new3 = timeframe.change("3")
[h3a, l3a, c3a] = request.security_lower_tf(syminfo.tickerid, lowTf ? timeframe.period : "3", [high, low, close])

// On a 15m chart, "5m or 15m" falls back to 15m wicks (5m candles are not visible there)
effMode = wickMode == "5m or 15m" and chartSec > 300 and chartSec <= 900 ? "15m" : wickMode
needSec = effMode == "15m" ? 900 : 300
tfOk = timeframe.isintraday and chartSec <= needSec

autoContract = str.contains(syminfo.ticker, "XAU") ? 100.0 : str.contains(syminfo.ticker, "XAG") ? 5000.0 : syminfo.type == "forex" ? 100000.0 : 1.0
contractSize = contractIn > 0 ? contractIn : autoContract

f_whole(p, step, down) => step > 0 ? (down ? math.floor(p / step) * step : math.ceil(p / step) * step) : p

// ===== Wick signals =====
bull5 = new5 and pc5 > ma and l5 <= ma and c5 > ma
bear5 = new5 and pc5 < ma and h5 >= ma and c5 < ma
bull15 = new15 and pc15 > ma and l15 <= ma and c15 > ma
bear15 = new15 and pc15 < ma and h15 >= ma and c15 < ma

longSig = switch effMode
    "5m" => bull5
    "15m" => bull15
    "5m or 15m" => bull5 or bull15
    => bull5 and bull15
shortSig = switch effMode
    "5m" => bear5
    "15m" => bear15
    "5m or 15m" => bear5 or bear15
    => bear5 and bear15

// ===== State =====
// 0 = OFF, 1 = WAITING FOR MA TOUCH, 2 = ARMED, 4 = WICK FOUND, WAITING 3M CLOSE, 3 = IN TRADE
var int state = 0
var int dir = 0
var int pDir = 0
var int pBar = na
var float entryPx = na
var float slPx = na
var float tpPx = na
var float riskDist = na
var bool beDone = false
var bool capped = false
var int wins = 0
var int losses = 0
var int bes = 0
var line beLn = na
var box tpBox = na
var box slBox = na

autoMode = mode == "Auto"
enabled = (autoMode or (active and time >= startTime)) and tfOk and not na(ma)

if not enabled and state != 3
    state := 0
else if enabled and state == 0
    state := 1

// Touch / pass of the 1H MA (incl. gaps through it)
touched = (low <= ma and high >= ma) or (low > ma and close[1] < ma) or (high < ma and close[1] > ma)
if state == 1 and touched
    state := 2

// ===== Wick found -> wait for 3m close =====
if state == 2 and longSig != shortSig
    d = longSig ? 1 : -1
    pDir := d
    pBar := bar_index
    state := 4

// ===== 3m fill =====
// SL goes at the wick of the 3m entry candle (low for long, high for short)
float fillPx = na
float sl3 = na
float postH = high
float postL = low
if state == 4
    if lowTf
        if new3 and bar_index > pBar
            fillPx := c3
            sl3 := pDir == 1 ? l3 : h3
    else
        n = array.size(c3a)
        if n >= 2 or (n >= 1 and barstate.isconfirmed)
            fillPx := array.get(c3a, 0)
            sl3 := pDir == 1 ? array.get(l3a, 0) : array.get(h3a, 0)
            postH := na
            postL := na
            if n > 1
                for i = 1 to n - 1
                    postH := na(postH) ? array.get(h3a, i) : math.max(postH, array.get(h3a, i))
                    postL := na(postL) ? array.get(l3a, i) : math.min(postL, array.get(l3a, i))
        else if bar_index > pBar
            state := 2

// ===== Entry =====
enteredLong = false
enteredShort = false
if not na(fillPx)
    d = pDir
    ep = fillPx
    tp0 = d == 1 ? f_whole(pdh, wholeStep, true) : f_whole(pdl, wholeStep, false)
    maxDist = (balanceIn * maxRiskPct / 100) / (lots * contractSize)
    slRaw = sl3 - d * slBuffer
    rawDist = d == 1 ? ep - slRaw : slRaw - ep
    validTp = not na(tp0) and (d == 1 ? tp0 > ep : tp0 < ep)
    // No wick on the 3m candle or no room to the target -> skip and stay armed
    if rawDist <= 0 or not validTp
        state := 2
    else
        dist = math.min(rawDist, maxDist)
        capped := rawDist > maxDist
        state := 3
        dir := d
        entryPx := ep
        slPx := ep - d * dist
        tpPx := tp0
        riskDist := dist
        beDone := false
        beLn := na
        enteredLong := d == 1
        enteredShort := d == -1
        rr = math.abs(tpPx - entryPx) / dist
        // Long / Short Position tool style: green profit zone, red loss zone
        tpBox := box.new(bar_index, math.max(entryPx, tpPx), bar_index + 1, math.min(entryPx, tpPx), border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85))
        slBox := box.new(bar_index, math.max(entryPx, slPx), bar_index + 1, math.min(entryPx, slPx), border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))
        tip = "Entry (3m close): " + str.tostring(entryPx, format.mintick) + "\nSL: " + str.tostring(slPx, format.mintick) + (capped ? " (capped at " + str.tostring(maxRiskPct) + "% risk)" : "") + "\nTP: " + str.tostring(tpPx, format.mintick) + "\nRR: " + str.tostring(rr, "#.##") + "\nLots: " + str.tostring(lots)
        label.new(bar_index, entryPx, d == 1 ? "L" : "S", color=color.new(color.blue, 20), textcolor=color.white, style=label.style_label_right, size=size.tiny, tooltip=tip)

// ===== Trade management =====
float exitPx = na
string res = ""
if state == 3
    hitSl = dir == 1 ? postL <= slPx : postH >= slPx
    hitTp = dir == 1 ? postH >= tpPx : postL <= tpPx
    beLevel = entryPx + dir * riskDist * beRR
    if hitSl
        exitPx := slPx
        res := beDone ? "BE" : "LOSS"
    else if hitTp
        exitPx := tpPx
        res := "WIN"
    else if not beDone and (dir == 1 ? postH >= beLevel : postL <= beLevel)
        beDone := true
        slPx := entryPx
        beLn := line.new(bar_index, entryPx, bar_index, entryPx, color=color.orange, style=line.style_dashed, width=1)
    if not na(beLn)
        line.set_x2(beLn, bar_index)
    box.set_right(tpBox, bar_index + 1)
    box.set_right(slBox, bar_index + 1)

exitWin = res == "WIN"
exitLoss = res == "LOSS"
exitBe = res == "BE"
if not na(exitPx)
    if exitWin
        wins += 1
    else if exitLoss
        losses += 1
    else
        bes += 1
    exitCol = exitWin ? color.green : exitLoss ? color.red : color.orange
    label.new(bar_index, exitPx, exitWin ? "W" : exitLoss ? "L" : "BE", color=exitCol, textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip=res + " @ " + str.tostring(exitPx, format.mintick))
    state := enabled ? 1 : 0
    dir := 0

// ===== Plots =====
plot(maRaw, "1H SMA200 (Low)", color=color.yellow, linewidth=2)
plot(smoothOn ? maSmooth : na, "Smoothed MA", color=color.aqua, linewidth=2)
bbUp = plot(smoothOn ? maSmooth + maDev : na, "BB Upper", color=color.new(color.green, 50))
bbLo = plot(smoothOn ? maSmooth - maDev : na, "BB Lower", color=color.new(color.green, 50))
fill(bbUp, bbLo, color=color.new(color.green, 92), title="BB Fill")
plot(showPD ? pdh : na, "Prev Day High", color=color.new(color.green, 60), style=plot.style_stepline)
plot(showPD ? pdl : na, "Prev Day Low", color=color.new(color.red, 60), style=plot.style_stepline)

alertcondition(enteredLong, "Long Entry", "MA200 Wick: LONG entry")
alertcondition(enteredShort, "Short Entry", "MA200 Wick: SHORT entry")
alertcondition(exitWin or exitLoss or exitBe, "Trade Exit", "MA200 Wick: trade closed")

// ===== Stats table =====
var table tbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 30))
f_row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=c, text_size=size.tiny, text_halign=text.align_right)

if showTable and barstate.islast
    statusTxt = not tfOk ? "Use ≤ " + (needSec == 900 ? "15m" : "5m") + " chart" : state == 0 ? "Off" : state == 1 ? "Wait MA touch" : state == 2 ? "Armed" : state == 4 ? "Wick, wait 3m" : dir == 1 ? "In long" : "In short"
    statusCol = state == 3 ? color.aqua : state == 2 or state == 4 ? color.yellow : color.white
    decided = wins + losses
    winRate = decided > 0 ? wins * 100.0 / decided : 0.0
    f_row(0, mode + " · " + effMode, statusTxt, statusCol)
    f_row(1, "W / L / BE", str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(bes), color.white)
    f_row(2, "Win rate", str.tostring(winRate, "#.#") + "%", winRate >= 50 ? color.green : color.red)
